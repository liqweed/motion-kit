/**
 * motion-kit · Astro adapter (reference).
 *
 * Server-renders the player's first state: the FINAL frame, the step list and
 * the style's colours, with the controls in place but inert. No-JS visitors,
 * crawlers and reduced-motion users get the complete diagram, and mounting the
 * live player moves nothing on the page. The player replays once when the
 * diagram scrolls into view.
 *
 * A spec for a registered scene type:
 *
 *   import AnimatedDiagram from "../motion-kit/adapter/AnimatedDiagram.astro";
 *   import spec from "../diagrams/order-flow.json";
 *   <AnimatedDiagram spec={spec} format="wide" locale="nl" class="hidden lg:block" />
 *   <AnimatedDiagram spec={spec} format="tall" locale="nl" class="lg:hidden" />
 *
 * A custom scene module, with options for its factory (text from the page's
 * dictionary, a view). Modules live under src/ and end in .scene.mjs or
 * .scene.js; name one by its path from the project root:
 *
 *   <AnimatedDiagram module="/src/diagrams/flow.scene.mjs" options={{ labels: t.flow }}
 *     format="wide" locale={lang} theme="light" style={brand} id="flow" />
 *
 * Props:
 *   spec      JSON spec for a registered scene type, or
 *   module    path of a custom scene module, "/src/…/name.scene.mjs"
 *   options   serializable options for the module's factory, passed unchanged
 *             (module only); the factory gets { ...options, format, locale, kit }
 *   format    "16:9" | "4:3" | "1:1" | "9:16" | "wide" | "tall" (default "16:9")
 *   locale    default "en"
 *   theme     "light" | "dark"; default: follow prefers-color-scheme
 *   style     token data (the shape `motion-kit --style` reads); default neutral
 *   id        HTML id of the root element, capture-hook key and id prefix:
 *             letters, digits, "_" and "-", starting with a letter, used once
 *             per page; default: generated, unique on the page
 *   scrubber  show a timeline scrubber (default false)
 *   labels    UI strings: flat { play, pause, … } or keyed by locale
 *   class     CSS classes for the root element
 *
 * Page scripts reach the live player through the root element: its
 * `controller` property, set on mount, and the `motion-ready` event (bubbling,
 * `detail.controller`), dispatched once the page's own scripts (and their
 * DOMContentLoaded and astro:page-load handlers) have run; `motion-error`
 * reports a failed mount. Use whichever comes first:
 *
 *   const el = document.getElementById("flow");
 *   const go = (c) => c.playToStep("paid");
 *   el.controller ? go(el.controller) : el.addEventListener("motion-ready", (e) => go(e.detail.controller), { once: true });
 *
 * Mount a wide and a tall instance and switch with CSS: display:none also
 * removes the hidden one from the accessibility tree and stops its clock.
 * Every prop must be serializable (a spec or a module path, not a scene).
 */
import { sceneFromModule } from "../runtime/kit.mjs";
import { PLAYER_CSS, playerMarkup, themeCss } from "../runtime/player.mjs";
import { claimId, claimStylesheet, newPageState } from "../runtime/page.mjs";
import { createScene } from "../runtime/types/index.mjs";

interface Props {
	spec?: Record<string, unknown>;
	module?: string;
	options?: Record<string, unknown>;
	format?: string;
	locale?: string;
	theme?: "light" | "dark";
	/** Token data, `{ name?, font?, light?: {…}, dark?: {…} }`, or "neutral". */
	style?: Record<string, unknown> | "neutral";
	id?: string;
	class?: string;
	scrubber?: boolean;
	/** Flat `{ play, pause, … }`, or a dictionary keyed by locale (`{ en: {…}, nl: {…} }`). */
	labels?: Record<string, string | Record<string, string>>;
}
const { spec, module: modulePath, options, format = "16:9", locale = "en", theme, style, id: idProp, class: className, scrubber = false, labels } = Astro.props;
const fail = (message: string): never => {
	throw new Error(`AnimatedDiagram: ${message}`);
};
if ((spec == null) === (modulePath == null)) fail('pass exactly one of spec (a JSON spec) or module (a path such as "/src/diagrams/flow.scene.mjs")');
if (spec && options) fail("options apply to custom scene modules; a spec takes none");
if (theme != null && theme !== "light" && theme !== "dark") fail(`theme must be "light" or "dark", got "${theme}"`);
if (typeof style === "string" && style !== "neutral") fail("style is token data (an object); use class for CSS");

const modules = import.meta.glob("/src/**/*.scene.{mjs,js}");
let scene;
if (spec) scene = createScene(spec, { format, locale });
else {
	const load = modules[modulePath as string];
	if (!load) fail(`no scene module at "${modulePath}". Modules live under src/ and end in .scene.mjs or .scene.js; found: ${Object.keys(modules).join(", ") || "none"}`);
	const mod = (await load()) as { default: unknown };
	scene = sceneFromModule(mod.default, { format, locale, options });
}

// Per page: the ids in use and whether the player stylesheet is out yet.
const page = ((Astro.locals as Record<string, any>).__motionKit ??= newPageState());
const id = (() => {
	try {
		return claimId(page, idProp, scene.id);
	} catch (error) {
		return fail((error as Error).message);
	}
})();
const css = claimStylesheet(page) ? `<style data-mk-player-css>${PLAYER_CSS}</style>` : "";
const tokens = `<style>${themeCss(`#${id}`, style, theme)}</style>`;
const markup = playerMarkup(scene, { id, style, theme, labels, locale, scrubber });
const config = JSON.stringify({ spec, module: modulePath, options, format, locale, theme, style, scrubber, labels });
---

<Fragment set:html={css + tokens} />
<div id={id} class:list={["mk-astro", "mk-player", className]} data-mk-astro={config} set:html={markup} />

<script>
	import { sceneFromModule } from "../runtime/kit.mjs";
	import { mountPlayer } from "../runtime/player.mjs";
	import { createScene } from "../runtime/types/index.mjs";

	type Controller = ReturnType<typeof mountPlayer>;
	type Root = HTMLElement & { controller?: Controller | null };
	// The same modules the server render can name; each loads on demand.
	const modules = import.meta.glob("/src/**/*.scene.{mjs,js}");
	const mounted = new Set<Root>();

	// Page scripts that come after this one must be able to listen: tell them
	// once the document is parsed, in a task after the current one, so their
	// DOMContentLoaded and astro:page-load handlers have run too.
	const parsed = new Promise<void>((resolve) => {
		const nav = performance.getEntriesByType?.("navigation")[0] as PerformanceNavigationTiming | undefined;
		if (document.readyState === "complete" || (nav?.domContentLoadedEventStart ?? 0) > 0) return resolve();
		document.addEventListener("DOMContentLoaded", () => resolve(), { once: true });
		addEventListener("load", () => resolve(), { once: true });
	});
	function announce(el: Root, type: "motion-ready" | "motion-error", detail: object) {
		void parsed.then(() =>
			setTimeout(() => {
				if (el.isConnected && mounted.has(el)) el.dispatchEvent(new CustomEvent(type, { bubbles: true, detail }));
			}, 0),
		);
	}

	async function mount(el: Root) {
		mounted.add(el);
		try {
			const cfg = JSON.parse(el.dataset.mkAstro ?? "{}");
			let scene;
			if (cfg.spec) scene = createScene(cfg.spec, { format: cfg.format, locale: cfg.locale });
			else {
				const load = modules[cfg.module];
				if (!load) throw new Error(`motion-kit: no scene module at "${cfg.module}"`);
				const mod = (await load()) as { default: unknown };
				// A page swap during the import released this element.
				if (!mounted.has(el) || !el.isConnected) return;
				scene = sceneFromModule(mod.default, { format: cfg.format, locale: cfg.locale, options: cfg.options });
			}
			const controller = mountPlayer(el, scene, { id: el.id, style: cfg.style, theme: cfg.theme, scrubber: cfg.scrubber, labels: cfg.labels, locale: cfg.locale });
			el.controller = controller;
			announce(el, "motion-ready", { controller });
		} catch (error) {
			// The server-rendered diagram stays as it is.
			announce(el, "motion-error", { error });
			console.error(error);
		}
	}
	function mountAll() {
		for (const el of document.querySelectorAll<Root>("[data-mk-astro]")) if (!mounted.has(el)) void mount(el);
	}
	function teardown() {
		for (const el of mounted) {
			el.controller?.destroy();
			el.controller = null;
		}
		mounted.clear();
	}

	mountAll();
	// Astro view transitions swap the DOM without reloading the page: release
	// the old players, then mount the new page's diagrams.
	document.addEventListener("astro:before-swap", teardown);
	document.addEventListener("astro:page-load", mountAll);
</script>
