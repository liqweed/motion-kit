{
	"name": "@liqweed/motion-kit",
	"version": "0.2.0",
	"description": "Deterministic animated diagrams: scenes as pure functions of time, for live pages, slides, baked SVG and video.",
	"keywords": [
		"animation",
		"diagrams",
		"svg",
		"slides",
		"video",
		"explainer",
		"slidev",
		"claude-code"
	],
	"homepage": "https://github.com/liqweed/motion-kit#readme",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/liqweed/motion-kit.git"
	},
	"bugs": "https://github.com/liqweed/motion-kit/issues",
	"author": "Ophir Radnitz",
	"type": "module",
	"license": "MIT",
	"files": [
		"cli/",
		"lib/",
		"runtime/",
		"adapters/",
		"styles/",
		"examples/",
		"brand/",
		"skills/",
		".claude-plugin/",
		"docs/spec/"
	],
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"engines": {
		"node": ">=22"
	},
	"bin": {
		"motion-kit": "cli/motion-kit.mjs"
	},
	"scripts": {
		"prepare": "lefthook install || true",
		"test": "node --test test/*.test.mjs",
		"typecheck": "tsc -p .",
		"check": "node cli/motion-kit.mjs check examples/order-flow.json examples/smart-home.json examples/release-pipeline.json examples/agent-loop.json examples/integrations.json examples/custom-pulse.scene.mjs brand/logo.scene.mjs",
		"media": "scripts/render-media.sh",
		"media:check": "scripts/render-media.sh --check",
		"site": "npm run -w website build",
		"site:dev": "npm run -w website dev",
		"site:deploy": "npm run -w website deploy",
		"versions": "node scripts/check-versions.mjs",
		"gate": "npm run -s typecheck && npm run -s versions && npm test && npm run -s check && npm run -s media:check && npm run -s site"
	},
	"optionalDependencies": {
		"@resvg/resvg-js": "^2.6.2"
	},
	"devDependencies": {
		"@types/node": "^22.20.5",
		"lefthook": "^2.2.2",
		"typescript": "^7.0.2"
	},
	"workspaces": [
		"website"
	]
}
