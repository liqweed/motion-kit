{
	"compilerOptions": {
		"allowJs": true,
		"checkJs": true,
		"noEmit": true,
		"strict": true,
		"noImplicitAny": false,
		"target": "es2023",
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"lib": ["es2023", "dom"],
		"types": ["node"],
		"skipLibCheck": true
	},
	"include": ["runtime/**/*.mjs", "bench/**/*.mjs", "lib/**/*.mjs", "cli/**/*.mjs", "brand/**/*.mjs", "examples/**/*.mjs", "test/**/*.mjs", "website/src/scripts/**/*.mjs", "website/src/scripts/**/*.d.ts", "website/*.mjs", "scripts/**/*.mjs"]
}
