{
	// Static site: Astro builds to ./dist, Cloudflare serves it as Workers static assets.
	// Deploy: npm run deploy -w website   (needs `wrangler login` or CLOUDFLARE_API_TOKEN)
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "motion-kit-dev",
	"compatibility_date": "2026-11-01",
	"assets": {
		"directory": "./dist",
		"not_found_handling": "404-page"
	}
}
