---
import icon from "../../../assets/icon.svg?url";
import { REPO } from "../scripts/catalog.mjs";

interface Props {
	page?: "home" | "gallery" | "docs" | "playground";
}
const { page } = Astro.props;
const links = [
	{ label: "Gallery", href: "/gallery/", key: "gallery" },
	{ label: "Where it runs", href: "/#where-it-runs", key: "", phoneHidden: true },
	{ label: "Playground", href: "/playground/", key: "playground" },
	{ label: "Docs", href: "/docs/", key: "docs" },
	{ label: "GitHub", href: REPO, key: "" },
];
---

<header class="site-header">
	<div class="wrap">
		<a class="brand" href="/"><img src={icon} alt="" width="32" height="32" /><span>motion-kit</span></a>
		<nav aria-label="Main">
			<ul class="nav-links">
				{links.map((l) => <li class:list={{ "hide-phone": l.phoneHidden }}><a href={l.href} aria-current={l.key && l.key === page ? "page" : undefined}>{l.label}</a></li>)}
			</ul>
		</nav>
	</div>
</header>
<div class="ruler-x" aria-hidden="true"></div>
